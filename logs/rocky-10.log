
## system

$ grep PRETTY_NAME /etc/os-release
PRETTY_NAME="Rocky Linux 10.2 (Red Quartz)"

$ uname -r
6.12.0-211.67.1.el10_2.x86_64

$ podman --version
podman version 5.8.2

$ getenforce
Enforcing

## 1. directory with mode 777

$ chmod 777 /root/selinux-lab-data

$ ls -ldZ /root/selinux-lab-data
drwxrwxrwx. 2 root root unconfined_u:object_r:admin_home_t:s0 6 Oct 22 15:14 /root/selinux-lab-data

$ podman pull -q docker.io/library/alpine:latest
b92841763c5c2140a20eeb2a44e94ebb0e80fd51d9d6b5895ea72fa999525d68

## 2. write from a container, no label option

$ podman run --rm -v /root/selinux-lab-data:/data docker.io/library/alpine:latest touch /data/hello
touch: /data/hello: Permission denied
# exit status 1

